<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="custom_layout">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o and o.company_id.sudo()">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <t t-call="tanmya_report_layout.tanmya_external_layout"><t t-out="0"/></t>

    </template>

    <template id="tanmya_external_layout">

        <!-- HEADER -->
        <div t-attf-class="header o_company_#{company.id}_layout">
            <div class="d-flex justify-content-between align-items-center mb-2">

                <!-- LEFT SIDE -->
                <div class="text-start">
                    <strong t-if="company.x_studio_printed_name_1st_row">
                        <span t-field="company.x_studio_printed_name_1st_row"/>
                    </strong><br/>
                    <t t-if="company.x_studio_printed_name_2nd_row">
                        <span t-field="company.x_studio_printed_name_2nd_row"/><br/>
                    </t>
                    <t t-if="company.x_studio_po_box">
                        P.O. Box: <span t-field="company.x_studio_po_box"/><br/>
                    </t>
                    <t t-if="company.phone">
                        Tel: <span t-field="company.phone"/><br/>
                    </t>
                    <t t-if="company.vat">
                        <span t-field="company.x_studio_tax_term"/>:
                        <span t-field="company.vat"/>
                    </t>
                </div>

                <!-- CENTER LOGO -->
                <div class="text-center">
                    <img
                        t-if="company.logo"
                        t-att-src="image_data_uri(company.logo)"
                        alt="Logo"
                        style="max-height:60px;"/>
                </div>

                <!-- RIGHT SIDE -->
                <div class="text-end">
                    <strong t-if="company.x_studio_printed_name_1st_row">
                        <span t-field="company.x_studio_printed_name_1st_row"/>
                    </strong><br/>
                    <t t-if="company.x_studio_printed_name_2nd_row">
                        <span t-field="company.x_studio_printed_name_2nd_row"/><br/>
                    </t>
                    <t t-if="company.x_studio_po_box">
                        P.O. Box: <span t-field="company.x_studio_po_box"/><br/>
                    </t>
                    <t t-if="company.phone">
                        Tel: <span t-field="company.phone"/><br/>
                    </t>
                    <t t-if="company.vat">
                        <span t-field="company.x_studio_tax_term"/>:
                        <span t-field="company.vat"/>
                    </t>
                </div>
            </div>
        </div>


        <!-- BODY -->
        <div
            t-attf-class="o_company_#{company.id}_layout article o_report_layout_striped o_table_striped o_snail_mail {{'o_report_layout_background' if company.layout_background != 'Blank' else ''}}"
            t-attf-style="{{ 'background-image: url(%s);' % layout_background_url if layout_background_url else '' }}"
            t-att-data-oe-model="o and o._name"
            t-att-data-oe-id="o and o.id"
            style="min-height:80vh;"
            t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <h2 t-out="layout_document_title"/>
            <t t-out="0"/>
        </div>

        <!-- FOOTER -->
        <div class="footer text-center o_company_#{company.id}_layout mt-auto">
            <div class="border-top border-bottom py-1">
                <span t-esc="company.website or 'http://www.example.com'"/>
            </div>
            <div class="mt-1 text-muted">
                Page: <span class="page"/> of <span class="topage"/>
            </div>
        </div>
    </template>
</odoo>
